#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/dvm"

usage() {
  cat <<'USAGE'
Usage:
  dvm-shred --list          List disposable VMs
  dvm-shred NAME            Stop and delete one VM
  dvm-shred --all           Stop and delete all disposable VMs (asks for confirmation)
  dvm-shred --all --yes     Stop and delete all without prompting
USAGE
}
die() { printf '[dvm-shred] ERROR: %s\n' "$*" >&2; exit 1; }

[[ -d "$STATE_ROOT" ]] || { echo "No disposable VMs found."; exit 0; }

is_our_qemu() {
  local pid="$1" run_dir="$2" cmdline
  [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
  cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  [[ "$cmdline" == *"$run_dir"* && "$cmdline" == *qemu-system-x86_64* ]]
}

list_vms() {
  local dir name port pid status
  printf '%-24s %-8s %-10s %s\n' NAME PORT STATUS DIRECTORY
  shopt -s nullglob
  for dir in "$STATE_ROOT"/*/; do
    [[ -d "$dir" ]] || continue
    name="${dir%/}"; name="${name##*/}"
    [[ -f "$dir/port" ]] || continue
    port="$(<"$dir/port")"
    pid=""
    [[ -f "$dir/qemu.pid" ]] && pid="$(<"$dir/qemu.pid")"
    if is_our_qemu "$pid" "$dir"; then status=running; else status=stopped/stale; fi
    printf '%-24s %-8s %-10s %s\n' "$name" "$port" "$status" "$dir"
  done
}

destroy_one() {
  local name="$1" dir="$STATE_ROOT/$name" pid="" port=""
  [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,39}$ ]] || die "Invalid VM name: $name"
  [[ -d "$dir" ]] || { echo "No instance named '$name'."; return 1; }
  [[ -f "$dir/port" ]] && port="$(<"$dir/port")"
  [[ -f "$dir/qemu.pid" ]] && pid="$(<"$dir/qemu.pid")"

  if is_our_qemu "$pid" "$dir"; then
    printf '[dvm-shred] Stopping %s (PID %s, SSH port %s)...\n' "$name" "$pid" "${port:-?}"
    kill -TERM "$pid" 2>/dev/null || true
    for _ in {1..10}; do
      is_our_qemu "$pid" "$dir" || break
      sleep 1
    done
    if is_our_qemu "$pid" "$dir"; then
      echo "[dvm-shred] QEMU did not stop promptly; forcing it to exit."
      kill -KILL "$pid" 2>/dev/null || true
      sleep 1
    fi
  else
    printf '[dvm-shred] No matching running QEMU process for %s; removing stale files.\n' "$name"
  fi

  rm -rf -- "$dir"
  printf '[dvm-shred] Destroyed %s and removed its overlay, cloud-init seed, host-key record, and logs.\n' "$name"
}

case "${1:-}" in
  --list|-l)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    list_vms
    ;;
  --all)
    [[ $# -le 2 ]] || { usage; exit 2; }
    yes=0
    if [[ "${2:-}" == "--yes" ]]; then yes=1; elif [[ $# -eq 2 ]]; then usage; exit 2; fi
    if (( ! yes )); then
      list_vms
      printf '\nThis permanently deletes all disposable VM overlays and state files (not the cached base image).\nType DELETE to continue: '
      read -r answer
      [[ "$answer" == "DELETE" ]] || { echo "Cancelled."; exit 1; }
    fi
    shopt -s nullglob
    for dir in "$STATE_ROOT"/*/; do
      [[ -d "$dir" && -f "$dir/port" ]] || continue
      name="${dir%/}"; name="${name##*/}"
      destroy_one "$name" || true
    done
    ;;
  "")
    usage
    exit 2
    ;;
  *)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    destroy_one "$1"
    ;;
esac
